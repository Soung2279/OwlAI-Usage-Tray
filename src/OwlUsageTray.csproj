<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OwlUsageTray</AssemblyName>
    <RootNamespace>OwlUsageTray</RootNamespace>
    <AssemblyTitle>OwlAI Usage Monitor</AssemblyTitle>
    <Product>OwlAI 用量监控</Product>
    <Description>OwlAI Codex subscription usage monitor for Windows</Description>
    <Company>Soung</Company>
    <Authors>Soung</Authors>
    <Copyright>Copyright © 2026 Soung</Copyright>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <ApplicationIcon Condition="Exists('icon.ico')">icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
